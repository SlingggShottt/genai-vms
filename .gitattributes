# Store everything with LF in the repo and check it out with LF
* text=auto eol=lf

# Windows-only scripts keep CRLF
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

# Binary files — never touch
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.pdf  binary
*.zip  binary
*.mp4  binary
*.ts   binary
*.npz  binary
*.pt   binary
*.safetensors binary
*.gguf binary