     "datasource": {
      "type": "prometheus",
      "uid": "vms-prometheus"
     },
     "expr": "sum by (group, topic) (vms_kafka_consumer_lag)",
     "legendFormat": "{{group}} / {{topic}}",
     "refId": "A"
    }
   ]
  },
  {
   "id": 16,
   "type": "timeseries",
   "title": "Messages dead-lettered, per hour",
