{
 "uid": "genai-vms-overview",
 "title": "GenAI-VMS overview",
 "tags": [
  "genai-vms"
 ],
 "timezone": "browser",
 "schemaVersion": 39,
 "version": 1,
 "refresh": "30s",
 "time": {
  "from": "now-3h",
  "to": "now"
 },
 "panels": [
  {
   "id": 1,
   "type": "stat",
   "title": "Services up",
   "description": "1 = scraped; a service not running in that mode shows 0",
   "datasource": {
    "type": "prometheus",
    "uid": "vms-prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 24,
    "h": 5
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "vms-prometheus"
     },
     "expr": "up",
     "legendFormat": "{{service}} ({{job}})",
     "refId": "A"
    }
   ]
  },
  {
   "id": 2,
   "type": "timeseries",
   "title": "Segment \u2192 searchable, p95",
   "description": "Seconds from a segment's end to its twin being indexed: the pipeline's end-to-end lag",
   "datasource": {
    "type": "prometheus",
    "uid": "vms-prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 5,
    "w": 8,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "vms-prometheus"
     },
     "expr": "histogram_quantile(0.95, sum by (le) (rate(vms_indexer_lag_seconds_bucket[5m])))",
     "legendFormat": "p95",
     "refId": "A"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "vms-prometheus"
     },
     "expr": "histogram_quantile(0.5, sum by (le) (rate(vms_indexer_lag_seconds_bucket[5m])))",
     "legendFormat": "p50",
     "refId": "B"
    }
   ]
  },
