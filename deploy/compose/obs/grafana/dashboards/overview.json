  {
   "id": 15,
   "type": "timeseries",
   "title": "Consumer lag",
   "description": "Messages a consumer group has not committed yet (design §15). Should return to ~0 after a burst.",
   "datasource": {
    "type": "prometheus",
    "uid": "vms-prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 45,
    "w": 8,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
