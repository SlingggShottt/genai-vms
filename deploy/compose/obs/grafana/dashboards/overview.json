     "legendFormat": "{{group}} / {{topic}}",
     "refId": "A"
    }
   ]
  },
  {
   "id": 17,
   "type": "timeseries",
   "title": "GPU memory",
   "description": "The whole card (nvidia-smi), not one process. Reported by perception on the GPU host.",
   "datasource": {
    "type": "prometheus",
    "uid": "vms-prometheus"
   },
   "gridPos": {
    "x": 16,
    "y": 45,
    "w": 8,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "bytes"
    },
    "overrides": []
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "vms-prometheus"
     },
     "expr": "max by (node, gpu) (vms_gpu_memory_bytes{kind=\"used\"})",
     "legendFormat": "used {{node}}/{{gpu}}",
     "refId": "A"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "vms-prometheus"
     },
     "expr": "max by (node, gpu) (vms_gpu_memory_bytes{kind=\"total\"})",
     "legendFormat": "total {{node}}/{{gpu}}",
     "refId": "B"
    }
   ]
  },
