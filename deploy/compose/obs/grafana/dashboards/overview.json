     },
     "expr": "sum by (service) (rate(vms_http_request_seconds_count[5m]))",
     "legendFormat": "{{service}}",
     "refId": "A"
    }
   ]
  },
  {
   "id": 20,
   "type": "timeseries",
   "title": "Share of requests ending in a 5xx",
   "description": "From vms_http_request_seconds; the ApiServerErrors alert fires above 5 %.",
   "datasource": {
    "type": "prometheus",
    "uid": "vms-prometheus"
   },
   "gridPos": {
    "x": 16,
    "y": 53,
    "w": 8,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit"
    },
    "overrides": []
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "vms-prometheus"
     },
     "expr": "sum by (service) (rate(vms_http_request_seconds_count{status=\"5xx\"}[5m])) / sum by (service) (rate(vms_http_request_seconds_count[5m]))",
     "legendFormat": "{{service}}",
     "refId": "A"
    }
   ]
  },
  {
   "id": 21,
   "type": "timeseries",
   "title": "Request time by route, p95 (slowest 8)",
   "description": "Streamed answers (assistant, search) count until their last byte, so they are long by design.",
   "datasource": {
    "type": "prometheus",
    "uid": "vms-prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 61,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "vms-prometheus"
     },
     "expr": "topk(8, histogram_quantile(0.95, sum by (le, service, route) (rate(vms_http_request_seconds_bucket[5m]))))",
     "legendFormat": "{{service}} {{route}}",
     "refId": "A"
    }
   ]
  },
  {
   "id": 22,
   "type": "stat",
   "title": "Alerts firing",
   "description": "From the rules in deploy/compose/obs/alerts.yml; empty is good.",
   "datasource": {
    "type": "prometheus",
    "uid": "vms-prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 61,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "vms-prometheus"
     },
     "expr": "sum by (alertname, severity) (ALERTS{alertstate=\"firing\"})",
