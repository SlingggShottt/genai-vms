# Copy to .env.prod on the VM (chmod 600). Never commit it. Runbook: deploy/compose/README.md.
# Generate secrets with:  openssl rand -base64 36 | tr -d '/+=' | cut -c1-32

# --- Where it is served ---
DOMAIN=vms.example.org            # DNS A/AAAA for DOMAIN and media.DOMAIN -> this VM
ACME_EMAIL=you@example.org        # Let's Encrypt contact
PUBLIC_IP=203.0.113.10            # the VM's public address, given to browsers for WebRTC media
# Content-Security-Policy-Report-Only to see what the policy would block without enforcing it.
# CSP_HEADER_NAME=Content-Security-Policy-Report-Only

# --- Images (built by .github/workflows/release.yml) ---
VMS_IMAGE_REPO=ghcr.io/your-github-owner   # lower case; images are <repo>/genai-vms-<service>
# VMS_TAG is set by update.sh <tag>; leave it out.

# --- Which services run (perception needs a GPU: not here) ---
COMPOSE_PROFILES=infra,core,genai,edge
# Add obs for Prometheus + Grafana (not behind Caddy: reach them through an SSH tunnel).

# --- Secrets: every one of these is required ---
POSTGRES_PASSWORD=
MINIO_ROOT_PASSWORD=
VMS_JWT_SECRET=
VMS_ADMIN_EMAIL=admin@example.org
VMS_ADMIN_PASSWORD=               # at least 8 characters; the first admin account
VMS_API_SERVICE_TOKEN=            # lets retrieval/reasoning call the api; any long random string

# --- Language models (cloud profile: no Ollama, no GPU) ---
VMS_LLM_PROFILE=cloud
GEMINI_API_KEY=
GROQ_API_KEY=

# --- Optional ---
# POSTGRES_USER=vms
# POSTGRES_DB=vms
# MINIO_ROOT_USER=vms-admin
# Footage older than this is not searched (recordings the retention policy has removed).
# VMS_RETRIEVAL_ARCHIVE_SINCE=2026-10-01T00:00:00+00:00
