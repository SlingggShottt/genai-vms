# Copy to .env and fill in secrets. Never commit .env (CLAUDE.md hard rule;
# gitleaks in pre-commit also blocks it). See docs/techstack.md and
# docs/design_architecture.md §11 for what reads each of these.

# --- Admin seed account (P1-J2 seeds this on first start) ---
# The email must be a normal address: POST /auth/login rejects reserved domains
# (.local, .test, .invalid, …) and the API refuses to seed one at startup.
# The password must be at least 8 characters (empty = don't seed).
VMS_ADMIN_EMAIL=admin@genai-vms.dev
VMS_ADMIN_PASSWORD=CHANGE_ME

# --- Postgres ---
POSTGRES_USER=vms
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=vms
VMS_DB_DSN=postgresql+asyncpg://vms:CHANGE_ME@localhost:5432/vms

# --- Kafka (vms_common.config.KafkaSettings) ---
VMS_KAFKA_BOOTSTRAP_SERVERS=localhost:9092
VMS_KAFKA_CONSUMER_GROUP_PREFIX=vms
VMS_KAFKA_DLQ_TOPIC=vms.dlq.v1

# --- Object storage / MinIO (vms_common.config.StorageSettings) ---
MINIO_ROOT_USER=vms-admin
MINIO_ROOT_PASSWORD=CHANGE_ME
VMS_STORAGE_ENDPOINT_URL=http://localhost:9000
VMS_STORAGE_ACCESS_KEY=vms-admin
VMS_STORAGE_SECRET_KEY=CHANGE_ME
VMS_STORAGE_REGION=us-east-1

# --- Redis (vms_common.config.RedisSettings) ---
VMS_REDIS_URL=redis://localhost:6379/0

# --- Qdrant ---
VMS_QDRANT_URL=http://localhost:6333

# --- LLM profile switch (D-08, FR-CFG-02): local | hybrid | cloud ---
VMS_LLM_PROFILE=local

# --- Free-tier cloud LLM keys — optional, only needed for hybrid/cloud profiles ---
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# --- Two-laptop demo (design_architecture.md §11.3) ---
# Laptop A (perception/pipeline) sets VMS_GENAI_HOST to laptop B's LAN IP.
# Laptop B (Ollama/reasoning/events/retrieval) sets VMS_INFRA_HOST to laptop A's LAN IP.
VMS_GENAI_HOST=localhost
VMS_INFRA_HOST=localhost

# --- JWT (P1-J2) ---
VMS_JWT_SECRET=CHANGE_ME

# --- Internal service-to-service auth (P1-J2, FR-AUTH-05) ---
# Shared secret for /internal/* — not a JWT. Every service that calls api's
# internal endpoints (e.g. VMS_INGESTION_SERVICE_TOKEN) must be set to this
# same value.
VMS_API_SERVICE_TOKEN=CHANGE_ME
