# Keeps Docker build contexts small — mirrors .gitignore plus large
# dataset/media exclusions that only matter for builds, not git.
.git
**/__pycache__
**/*.py[cod]
**/*.egg-info
.pytest_cache
.ruff_cache
.venv
venv

frontend/node_modules
frontend/dist

.env
.env.*
!.env.example

ml/**/checkpoints
ml/**/outputs
ml/**/wandb
ml/**/*.mp4
ml/**/*.avi
ml/**/*.mkv
ml/datasets/**/raw

.DS_Store
Thumbs.db
.vscode
.idea
